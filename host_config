# Example host config file, for run-kvm.sh
#
# ***NB: IF WANTING TO USE run-kvm.sh AS A STANDALONE VIRTUALIZATION
#        BENCHMARKING TOOL (I.E., OUTSIDE OF MARVIN), MMTESTS_HOST_IP
#        *MUST* BE DEFINED (SO, UNCOMMENT THE LINE BELOW AND SET IT
#        TO THE PROPER VALUE).***
#
#export MMTESTS_HOST_IP="192.168.122.1"
#export AUTO_PACKAGE_INSTALL="yes"

# SSH options, in the sshd_config(5) format (see `-o` in `man ssh`). MMTests
# already uses `-o StrictHostKeyChecking=no` (and a few others, e.g., for
# passwordless login).
#
# Note that all the options specified here, will be used for rsync, and
# anything involving SSH.
#export MMTESTS_SSH_CONFIG_OPTIONS="-o LogLevel=INFO"

# Let's have run-mmtests.sh output from the VMs in /tmp
#export MMTESTS_PARALLEL_OUTDIR=/tmp

# List of VMs inside which to run the tests
# (if not specified via command line)
#export MMTESTS_VMS="vm1 vm2"

# When running benchmarks in multiple VMs, coordination between the host and
# the VMs happens over network. VMs will contact the host at MMTESTS_HOST_PORT
# (TCP) port, while host will contact guests at MMTESTS_GUEST_PORT (TCP) port.
#export MMTESTS_HOST_PORT=1234
#export MMTESTS_GUEST_PORT=4321

# If we find already defined VMs in the system, shall we undefine them and
# (try to) re-create them from scratch? By default, we do *NOT* do that, and
# just use it. If, instead, they should be deleted and re-created from scratch
# set MMTESTS_VMS_UNDEF_BEFORE_START to "yse".
#
# Setting MMTESTS_VMS_UNDEF_REMOVE_STORAGE to "yes" as well, will make sure
# that not only the existing VM is undefined, but its storage is also removed
# (and, presumibly, recreated).
#export MMTESTS_VMS_UNDEF_BEFORE_START="yes"
#export MMTESTS_VMS_UNDEF_REMOVE_STORAGE="yes"

# The location of config files for guests (e.g., libvirt xml config files for
# VMs) that are not defined already when starting the benchmark can be listed
# in this variable. They will then be read and an attempt to define such VMs
# will be made, before starting the tests. A (coma separated) list of dirs
# can be specified.
#
# If using both this variable and the --vm-xml-dir command line switch, the
# latter has priority. Also, MMTests will always check if there are suitable
# xml files in the main directory (see $SCRIPTDIR), as last resort.
#
# Order matters as, for each VM, we will stop and use the first suitable
# config file that we find.
#export MMTESTS_VMS_XML_DIR=

# The list of the VMs in which we want to run the benchmarks can be specified
# in multiple ways:
# - command line (--vm or --vms parameter)
# - here, in the host config file, via MMTESTS_VMS
# - here, in the host config file, via MMTESTS_VMS_IP
#
# Command line has priority, so, if there's a --vm (or --vms) parameter,
# both MMTESTS_VMS and MMTESTS_VMS_IP will be ignored. If there's no such
# parameter, MMTESTS_VMS and MMTESTS_VMS_IP are checked, and they must be
# considered mutially exclusive (i.e., if one is defined, the other must
# be empty!).
#
# If only MMTESTS_VMS_IP is defined, run-kvm.sh will assume that a set of
# VMs with those IP addresses is already running, and will "just" try to
# reach them and run the benchmarks inside them. If that is not the case
# it will fail. It will also not try to shut them down at the end, nor
# to manage their lifecycle in any way.
#
# If, on the other hand, we have the VM names (either via MMTESTS_VMS or
# via command line), run-kvm.sh will be able to try to enact a much more
# sophisticated handling of the VMs lifecycle (like starting and stopping
# them automatically, but also more than just that).
#export MMTESTS_VMS_IP="192.168.122.24 192.168.122.38"
#export MMTESTS_VMS="vm_a vm_b"

# Install location, distribution and AutoYaST file, valid for all
# VMs (unless a more specific entry is present below).
#export MMTESTS_VMS_INSTALL_LOCATION=
#export MMTESTS_VMS_AUTOYAST_DIR=
#export MMTESTS_VMS_AUTOYAST="${SCRIPTDIR}/autoyast/opensuse.xml.erb"
#export MMTESTS_VMS_DEPLOY_DISTRO="openSUSE-Tumbleweed"

# MMTESTS_DEPLOY_DISTRO_SPEC is a "table" where:
# - each "row" describes an OS/distribution that can be deployed inside a VM;
# - the first "column" is the tag/name, used to refer to the entire row in
#   various places (e.g., in the MMTESTS_VMS_DEPLOY_DISTRO variable);
# - the second "column" is the so-called install location, i.e., from where
#   the kernel and intrd images and the various packages should be retrieved
#   (in case of network-based deployments);
# - the third "column" is the name (or the path) of an AutoYaST file, used
#   for making sure that the deploy happens in a fully non-interactive way.
#   It can be the path of a valid AutoYaST profile that MMTests can fetch
#   on the local filesystem, or the URL of one.
#export MMTESTS_DEPLOY_DISTRO_SPEC="
#my-Leap-15.3@https://download.opensuse.org/pub/opensuse/distribution/leap/15.3/repo/oss/@Leap-15.6_autoyast.xml
#Tumbleweed@https://download.opensuse.org/pub/opensuse/tumbleweed/repo/oss/@$MMTESTS_VMS_AUTOYAST
#"

# Characteristics of the VMs. Valid for all VMs, unless a more
# specific entry is present (below).
#
# TODO: Add a few words about the meaning and the use of each of these
# (especially the disk format and deploying strategy ones).
#export MMTESTS_VMS_MEMORY=
#export MMTESTS_VMS_CPUS=
#export MMTESTS_VMS_DISK_POOL=
#export MMTESTS_VMS_DISK_FILE_SIZE=
#export MMTESTS_IMPORT_DISK_FILE=
#export MMTESTS_COPY_DISK_FILE=
#export MMTESTS_COPY_DISK_COW=
#export MMTESTS_COPY_DISK_DEST_PATH=

# If the VM(s) is (are) imported, its (their) disk image can be
# a copy of an already existing one:
#export MMTESTS_VMS_COPY_DISK_FILE=/vmimages/vms.disk

# All the above entries can be made more specific, e.g., they can be
# specialized on a per-VM basis, in two ways (in this order):
# - Associative arrays
# - Standard variables
#
# The associative arrays way works as follows (note the lack of 'export'
# at the beginning of the lines!):
#
# VM_CPUS["<vmname>"]=<value>
# VM_MEMORY["<vmname>"]=<value>
# ...
#
# The "standard variable way" involves defining standard config
# variables with the name of the VM (as defined in the MMTESTS_VMS
# array) as prefix, in spite of MMTESTS_.
#
# Note that this can be done only for VMs whose name is a valid Bash
# identifier, i.e., only letters, numbers (but not at the beginning)
# and "_". E.g., "opensuse-leap" is not, due to the "-".
#
# For example, this is how one ca speficy that the VM called
# "opensuse-leap-15.4" shall have 2 vCPUs and 8 GB of RAM:
# VM_CPUS["opensuse-leap-15.4"]=2
# VM_MEMORY["opensuse-leap-15.4"]=8196
#
# And this is how we can specify that, instead, "vm1" shall be a
# deployment of openSUSE Tumbleweed, with 4 vCPUs and 4 GB of RAM:
#export vm1_DEPLOY_DISTRO="openSUSE-Tumbleweed"
#export vm1_CPUS=4
#export vm1_MEMORY=4096

# If `numad` should be used on the host
#export MMTESTS_NUMA_POLICY="numad"

# The `tuned` that will be used on the host
#export MMTESTS_TUNED_PROFILE="latency-performance"

# List of monitors for the host
export RUN_MONITOR=yes
export MONITORS_ALWAYS=
export MONITORS_GZIP="proc-vmstat mpstat"
export MONITORS_WITH_LATENCY="vmstat"
export MONITOR_UPDATE_FREQUENCY=1
