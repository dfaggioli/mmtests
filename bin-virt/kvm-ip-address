#!/bin/bash
# shellcheck enable=require-variable-braces
#
# This script obtains the IP address of a marvin-based KVM instance. It can
# optionally timeout
#
# VM name is passed as first parameter, i.e., `--vm foo`. If no `--vm` param
# is passed, the VM name is assumed to be in $MARVIN_KVM_DOMAIN. If such
# variable is undefined, we fall back to `marvin-mmtests`.
#
# If both VM name and timeout must be specified, `--vm foo` should be the
# first parameter and timeout the second.
#
# Mel Gorman <mgorman@suse.com> 2016
# Dario Faggioli <dfaggioli@suse.com> 2026

#!/bin/bash
# shellcheck enable=require-variable-braces

set -euo pipefail

basedir="$(dirname "${0}")"
SCRIPTDIR="${SCRIPTDIR:-$(cd "${basedir}/.." && pwd)}"

# shellcheck source=shellpacks/common.sh
source "${SCRIPTDIR}/shellpacks/common.sh"
# shellcheck source=shellpacks/virt.sh
source "${SCRIPTDIR}/shellpacks/virt.sh"

: "${MARVIN_KVM_DOMAIN:=marvin-mmtests}"

vm_name="${MARVIN_KVM_DOMAIN}"
timeout=""

# Legacy CLI parsing: handle optional --vm flag
if [[ "${1:-}" == "--vm" ]]; then
	if [[ -z "${2:-}" ]]; then
		echo "ERROR: --vm requires a VM name." >&2
		exit "${SHELLPACK_ERROR:--1}"
	fi
	vm_name="${2}"
	shift 2
fi

# If a parameter is still present after potential shifts, it is the timeout
if [[ -n "${1:-}" ]]; then
	timeout="${1}"
fi

libvirt::vm_ip_address "${vm_name}" "${timeout}"
# Propagate the exact exit code from the library function
exit $?
